{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with saved football squad, balance, unlockables, and match statistics",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID of the player"
        },
        "email": {
          "type": "string",
          "description": "Email address of the authenticated player"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL of the player"
        },
        "coins": {
          "type": "number",
          "description": "Coin balance available for signing players and upgrades"
        },
        "matchesPlayed": {
          "type": "number",
          "description": "Total matches played"
        },
        "wins": {
          "type": "number",
          "description": "Total match victories"
        },
        "losses": {
          "type": "number",
          "description": "Total match defeats"
        },
        "ties": {
          "type": "number",
          "description": "Total match draws"
        },
        "totalGoals": {
          "type": "number",
          "description": "Total goals scored by the player"
        },
        "teamName": {
          "type": "string",
          "description": "Custom team name"
        },
        "playerName": {
          "type": "string",
          "description": "Captained player name"
        },
        "playerNumber": {
          "type": "number",
          "description": "Jersey number of the star player"
        },
        "jerseyColor": {
          "type": "string",
          "description": "Hex color code for the team jersey"
        },
        "shortsColor": {
          "type": "string",
          "description": "Hex color code for the team shorts"
        },
        "rivalColor": {
          "type": "string",
          "description": "Hex color code for rival team jersey"
        },
        "unlockedPlayerIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of unlocked special player IDs"
        },
        "unlockedAchievementIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of unlocked achievement badges"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last save"
        }
      },
      "required": ["userId", "coins"]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time online presence beacon of connected players",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier of the player session"
        },
        "displayName": {
          "type": "string",
          "description": "Player or manager display name"
        },
        "teamName": {
          "type": "string",
          "description": "Team club name"
        },
        "jerseyColor": {
          "type": "string",
          "description": "Primary jersey color hex"
        },
        "shortsColor": {
          "type": "string",
          "description": "Shorts color hex"
        },
        "playerNumber": {
          "type": "number",
          "description": "Captained shirt number"
        },
        "status": {
          "type": "string",
          "enum": ["menu", "matchmaking", "in_match"],
          "description": "Current activity of the user in the app"
        },
        "lastSeen": {
          "type": "string",
          "description": "ISO timestamp of the most recent heartbeat"
        }
      },
      "required": ["userId", "displayName", "lastSeen"]
    },
    "MatchRoom": {
      "title": "MatchRoom",
      "description": "Multiplayer 1v1 football match room session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique room ID code (e.g., match_xxx or custom code)"
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "starting", "playing", "finished", "abandoned"],
          "description": "Current status of the match room"
        },
        "hostId": {
          "type": "string",
          "description": "Player ID of the room creator (Host)"
        },
        "hostName": {
          "type": "string",
          "description": "Display name of the host player"
        },
        "guestId": {
          "type": "string",
          "description": "Player ID of the joined opponent (Guest)"
        },
        "guestName": {
          "type": "string",
          "description": "Display name of the joined opponent"
        },
        "scoreHome": {
          "type": "number",
          "description": "Home team goals score"
        },
        "scoreAway": {
          "type": "number",
          "description": "Away team goals score"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the match was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "status", "hostId", "hostName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user game save and profile document accessible exclusively by the document owner"
    },
    "/presence/{userId}": {
      "schema": "UserPresence",
      "description": "Public real-time presence indicators of online players"
    },
    "/matches/{matchId}": {
      "schema": "MatchRoom",
      "description": "Real-time online multiplayer match room for live matchmaking and PvP matches"
    }
  }
}
